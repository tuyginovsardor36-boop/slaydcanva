# OPENROUTER_API_KEY: Required for OpenRouter AI generation on the server.
# Configure this in Settings > Secrets in AI Studio (never expose to client).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Optional preferred OpenRouter model ID (e.g. google/gemini-2.5-flash or openrouter/free).
OPENROUTER_MODEL="google/gemini-2.5-flash"

# GEMINI_API_KEY: Fallback Gemini AI API key when OpenRouter is not configured.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TOLOVGO_API_KEY: Required for real UZS top-up payments via tolovgo.uz on the server.
# Configure this in Settings > Secrets in AI Studio (never expose to client).
TOLOVGO_API_KEY="MY_TOLOVGO_API_KEY"

# TOLOVGO_TEST_API: Optional TolovGo test key (starts with test_) for free sandbox testing.
TOLOVGO_TEST_API="MY_TOLOVGO_TEST_API"

# TOLOVGO_MODE: Optional "live" or "test" selector when both keys are present.
TOLOVGO_MODE="live"

# TOLOVGO_API_BASE: Optional custom TolovGo API or Next.js/Vercel proxy base URL.
TOLOVGO_API_BASE="https://pay.tolovgo.uz/api"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather for webhook, auth, notifications, and document delivery.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# TELEGRAM_BOT_USERNAME: Bot username without @ (e.g. slaydcanva_bot).
TELEGRAM_BOT_USERNAME="MY_TELEGRAM_BOT_USERNAME"

# TELEGRAM_WEBHOOK_SECRET: Secret token to verify Telegram webhook requests & protect setup-webhook endpoint.
TELEGRAM_WEBHOOK_SECRET="MY_TELEGRAM_WEBHOOK_SECRET"

# TELEGRAM_SESSION_SECRET: Secret key used to sign auth session cookies/tokens.
TELEGRAM_SESSION_SECRET="MY_TELEGRAM_SESSION_SECRET"

# Optional Vercel KV / Upstash Redis REST credentials for persistent bot balance & history across serverless instances.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Neon PostgreSQL connection string (automatically injected as DATABASE_URL / POSTGRES_URL by Vercel Neon Connect).
DATABASE_URL="MY_DATABASE_URL"

# ADMIN_TELEGRAM_ID: Numeric Telegram user ID allowed to access the Admin Dashboard and set the admin password.
ADMIN_TELEGRAM_ID=""

